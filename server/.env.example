# Sao chep file nay thanh server/.env, sau do dien gia tri that.
# server/.env da duoc .gitignore bao ve, khong dua len GitHub.

NODE_ENV=development
RESEND_API_KEY=re_THAY_BANG_KHOA_API_RESEND

# Thu nhanh: onboarding@resend.dev chi gui duoc toi chinh email da dung
# dang ky tai khoan Resend.
EMAIL_FROM="VAST <onboarding@resend.dev>"

# Ma OAuth 2.0 Client ID loai "Web application" tren Google Cloud.
# Day la ma cong khai (khong phai Client Secret).
GOOGLE_CLIENT_ID=""

# Danh sach so dien thoai tai khoan VAST duoc vao trang quan tri ho tro.
# Neu co nhieu admin, ngan cach bang dau phay. Khong dung truong vai tro ho so.
VAST_ADMIN_PHONES="0901234567"

# Web Push. Neu de trong, VAST tu sinh mot cap khoa va luu trong
# server/data/push-vapid.json (thu muc data phai duoc backup/persistent tren VPS).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@tenmien-cua-ban.vn"

# Ban trien khai cho moi nguoi dung: xac minh ten mien trong Resend, roi doi:
# EMAIL_FROM="VAST <no-reply@tenmien-cua-ban.vn>"
